# Database
# `npm run infra:up` ile acilan local MySQL varsayilanlari.
DATABASE_URL="mysql://hushle:hushle@127.0.0.1:3307/hushle_dev"
DATABASE_CONNECTION_LIMIT=20

# NextAuth
AUTH_SECRET="replace_with_a_strong_random_value_at_least_32_chars"
NEXTAUTH_URL="http://localhost:3000"
# Production benzeri localhost testlerinde Auth.js host trust hatasi almamak icin:
# AUTH_TRUST_HOST="true"
# Reverse proxy / custom host kullaniminda bunu bilinclı sekilde ac.
AUTH_TRUST_HOST="false"

# OAuth / OIDC. Google is opt-in and provider tokens are not persisted.
# Callback: http://localhost:3000/api/auth/callback/google
GOOGLE_OAUTH_ENABLED=false
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Google Search Console HTML etiketi dogrulamasi. DNS dogrulamasi kullaniyorsan bos birak.
GOOGLE_SITE_VERIFICATION=""
# Browser tabanli Socket.IO istemcileri icin tam origin allowlist.
# Wildcard ve path kabul edilmez. Ornek:
# TRUSTED_WEB_ORIGINS="https://admin.example.com,https://play.example.com"
TRUSTED_WEB_ORIGINS=""
# Native mobil/server Socket.IO istemcileri genelde Origin gondermez. Mobil API
# kimlik dogrulamasi hazir olmadan production'da true yapma.
ALLOW_ORIGINLESS_SOCKET_CLIENTS="false"

# Harici stylesheet/font/socket kaynaklari CSP'ye direktif bazinda eklenir.
# Google Fonts ornegi:
# CSP_STYLE_SOURCES="https://fonts.googleapis.com"
# CSP_FONT_SOURCES="https://fonts.gstatic.com"
# Ayrik API veya Socket.IO hostu ornegi:
# CSP_CONNECT_SOURCES="https://api.example.com,wss://socket.example.com"
CSP_STYLE_SOURCES=""
CSP_FONT_SOURCES=""
CSP_CONNECT_SOURCES=""
NODE_ENV="development"
HOST="localhost"
# Opsiyonel mobile/public API runtime. Browser originleri exact allowlist'tir;
# native mobil istemciler Origin gondermeyebilir ve ileride bearer auth kullanir.
API_HOST="127.0.0.1"
API_PORT=3001
API_ALLOWED_ORIGINS="http://localhost:3000"
# Production'da public auth endpointlerini acmak icin bilincli olarak true yap.
MOBILE_AUTH_ENABLED=false
API_TRUST_PROXY=false
MOBILE_ACCESS_TOKEN_TTL_MS=900000
MOBILE_REFRESH_TOKEN_TTL_MS=2592000000
MOBILE_AUTH_RETENTION_DAYS=30
MOBILE_AUTH_REUSE_EVIDENCE_DAYS=7
MOBILE_AUTH_RETENTION_BATCH_SIZE=500
MOBILE_AUTH_RETENTION_LEASE_TTL_MS=300000
WORD_POOL_SIZE=120
ADMIN_TIMEOUT_MS=180000
PLAYER_TIMEOUT_MS=15000
# Yalniz app gercekten guvendigin bir reverse proxy arkasindaysa "true" yap.
# "false" iken x-forwarded-for / x-real-ip audit ve rate-limit icin dikkate alinmaz.
TRUST_PROXY=false

# Redis / Valkey
# `npm run infra:up` ile acilan local Redis host portu varsayilan olarak 6381'dir.
# Redis gecici olarak ulasilamazsa uygulama memory fallback ile calisir ve
# REDIS_RETRY_COOLDOWN_MS sonrasinda yeniden baglanmayi dener.
REDIS_PORT=6381
REDIS_URL="redis://127.0.0.1:6381"
REDIS_KEY_PREFIX="hushle:development"
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_RETRY_COOLDOWN_MS=30000
CACHE_MEMORY_MAX_ENTRIES=500

# Yeni kayit parolalarini HIBP Pwned Passwords k-anonimlik servisiyle kontrol eder.
# Servis gecici olarak erisilemezse yerel guc politikasi uygulanmaya devam eder.
PASSWORD_BREACH_CHECK_ENABLED=true

# Room state process-local kaldigi icin tek realtime writer zorunludur.
REALTIME_TOPOLOGY=single-writer
REALTIME_REPLICA_COUNT=1
SOCKET_IO_POLLING_ENABLED=true
# Adapter event fanout saglar; room state halen process-local oldugu icin varsayilan kapali.
SOCKET_IO_REDIS_ADAPTER_ENABLED=false
# Polling transport'u birden fazla instance'a dagitmadan once load balancer affinity gerekir.
SOCKET_IO_STICKY_SESSIONS_CONFIGURED=false
# Oda create lease temeli; routing/state sharing tamamlanana kadar varsayilan kapali.
ROOM_OWNERSHIP_LEASE_ENABLED=false
ROOM_OWNERSHIP_LEASE_TTL_MS=30000
ROOM_OWNERSHIP_RENEW_INTERVAL_MS=10000
# Multi-instance deploylarda her realtime instance icin benzersiz ve stabil bir ad ver.
# Bos birakilirsa hostname + process id kullanilir.
INSTANCE_ID=""

# Siradan finalize olaylarini PII icermeyen Redis gunluk rollup'a tasir.
# Redis kullanilamazsa mevcut detayli audit yazimina geri duser.
MATCH_FINALIZE_TELEMETRY_ROLLUP_ENABLED=false
TELEMETRY_ROLLUP_RETENTION_DAYS=45

# PII'siz urun analytics olaylarini ham event satiri tutmadan gunluk Redis
# aggregate olarak kaydeder. Audit veya kalici oyun verisinin yerine gecmez.
PRODUCT_ANALYTICS_ENABLED=false
PRODUCT_ANALYTICS_RETENTION_DAYS=45

# Server-owned dogru/tabu/pas/timeout kelime aggregate'lari.
WORD_ANALYTICS_ENABLED=false
WORD_ANALYTICS_RETENTION_DAYS=45

# One-shot jobs runtime. Mutating jobs require both JOBS_ENABLED=true and
# explicit execute mode. Audit retention only archives; it does not purge
# archive records.
JOBS_ENABLED=false
JOBS_DATABASE_CONNECTION_LIMIT=3
AUDIT_HOT_RETENTION_DAYS=90
AUDIT_ARCHIVE_BATCH_SIZE=500
AUDIT_ARCHIVE_MAX_BATCHES=10
AUDIT_ARCHIVE_LEASE_TTL_MS=900000

# MySQL offsite backup (yalniz ops scriptleri/container'i kullanir)
# false iken backup sadece local disk + SHA-256 uretir.
BACKUP_REMOTE_ENABLED=false
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="auto"
BACKUP_S3_BUCKET=""
BACKUP_S3_PREFIX="hushle"
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
# docker: amazon/aws-cli container; host: makinedeki aws-compatible CLI.
BACKUP_S3_CLI_MODE="docker"
# Resmi AWS ECR Public image'i immutable tam surume pinlidir.
BACKUP_AWS_CLI_IMAGE="public.ecr.aws/aws-cli/aws-cli:2.36.10"
BACKUP_REMOTE_RETENTION_DAYS=30

# Health endpoint:
# - development: acik
# - production: x-health-token header ile korunur
# Bos birakirsan production'da /api/health 404 doner.
HEALTHCHECK_TOKEN=""

# Central structured event exporter. Local development stays disabled.
# Production preflight requires: http | disabled_risk_accepted
PRODUCTION_OBSERVABILITY_POLICY=disabled_risk_accepted
OBSERVABILITY_EXPORT_MODE=disabled
OBSERVABILITY_EXPORT_URL=""
OBSERVABILITY_EXPORT_TOKEN=""
OBSERVABILITY_EXPORT_BATCH_SIZE=20
OBSERVABILITY_EXPORT_QUEUE_LIMIT=500
OBSERVABILITY_EXPORT_FLUSH_INTERVAL_MS=5000
OBSERVABILITY_EXPORT_TIMEOUT_MS=3000

# Rate Limiting (set to "false" to disable for testing)
RATE_LIMIT_ENABLED=false
ROOM_JOIN_MAX_ATTEMPTS=1000
ROOM_JOIN_WINDOW_SECONDS=60
# strict: state-changing web API requests require an allowlisted Origin.
# compatible: development/test clients may omit Origin and Sec-Fetch-Site.
STATE_CHANGE_ORIGIN_POLICY=compatible

# Captcha Providers
# Production deploy preflight requires an explicit decision:
# turnstile | disabled_risk_accepted
PRODUCTION_CAPTCHA_POLICY=disabled_risk_accepted
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Exact comma-separated hostnames only; no scheme, path, port, or wildcard.
# Production preflight requires the NEXT_PUBLIC_SITE_URL hostname to be present.
TURNSTILE_ALLOWED_HOSTNAMES=""
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Production edge decision. Cloudflare Free cannot exempt payment callbacks from
# Bot Fight Mode, so keep it disabled until every provider webhook passes live smoke.
PRODUCTION_EDGE_SECURITY_POLICY=direct_origin_risk_accepted
CLOUDFLARE_PROXY_ENABLED=false
CLOUDFLARE_ORIGIN_LOCK_MODE=""
CLOUDFLARE_BOT_FIGHT_MODE=disabled_until_webhook_smoke
PAYMENT_WEBHOOK_EDGE_POLICY=signature_first_no_challenge

# Payment checkout remains disabled until one provider adapter passes sandbox,
# webhook and production smoke tests. Credentials alone never enable an adapter.
PAYMENTS_ENABLED=false
PAYMENT_ACTIVE_PROVIDER=""
# Shopier publishes a live v1 API, not a sandbox checkout API. Keep disabled until
# signed order/refund webhooks, reconciliation and a real low-value acceptance pass.
SHOPIER_PERSONAL_ACCESS_TOKEN=""
SHOPIER_PRODUCT_MEDIA_URL=""
SHOPIER_CHECKOUT_MODE=disabled
SHOPIER_WEBHOOK_MODE=disabled
SHOPIER_RECONCILIATION_MODE=disabled
SHOPIER_REFUND_MODE=disabled
SHOPIER_WEBHOOK_TOKEN=""
SHOPIER_ACCOUNT_ID=""
SHOPIER_LIVE_ACCEPTANCE_RECORDED=false
SHOPIER_LIVE_ACCEPTANCE_EVIDENCE_FILE=""
SHOPIER_LIVE_ACCEPTANCE_EVIDENCE_SHA256=""
# Operator-only live acceptance CLI. Keep PAYMENTS_ENABLED=false and
# SHOPIER_REFUND_MODE=disabled until the final evidence is generated.
SHOPIER_ACCEPTANCE_CONFIRM=""
SHOPIER_ACCEPTANCE_MAX_AMOUNT_MINOR=5000
SHOPIER_ACCEPTANCE_USER_ID=""
SHOPIER_ACCEPTANCE_OFFER_CODE=""
SHOPIER_ACCEPTANCE_ORDER_ID=""
SHOPIER_ACCEPTANCE_REVIEWER_USER_ID=""
SHOPIER_ACCEPTANCE_REVERSAL_REQUEST_ID=""
SHOPIER_ACCEPTANCE_PAYMENT_CHECKPOINT_FILE=""
SHOPIER_ACCEPTANCE_REFUND_CHECKPOINT_FILE=""
SHOPIER_ACCEPTANCE_EVIDENCE_FILE=""
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_MERCHANT_ID=""
# Foundation hazır olsa da orchestration/webhook tamamlanana kadar disabled kalır.
IYZICO_CHECKOUT_MODE=disabled
# Signature V3 merchant hesabında açılmadan sandbox yapılmamalıdır.
IYZICO_WEBHOOK_MODE=disabled
IYZICO_RECONCILIATION_MODE=disabled
IYZICO_OWNER_CHECKOUT_MODE=disabled
IYZICO_CALLBACK_MODE=disabled
IYZICO_SANDBOX_ACCEPTANCE_RECORDED=false
IYZICO_SANDBOX_ACCEPTANCE_EVIDENCE_FILE=""
IYZICO_SANDBOX_ACCEPTANCE_EVIDENCE_SHA256=""
# Yalnız manuel sandbox kabul komutunda geçici process environment olarak kullanın.
IYZICO_SANDBOX_ACCEPTANCE_CONFIRM=""
IYZICO_ACCEPTANCE_PUBLIC_ORIGIN=""
IYZICO_ACCEPTANCE_USER_ID=""
IYZICO_ACCEPTANCE_OFFER_CODE=""
IYZICO_ACCEPTANCE_ORDER_ID=""
IYZICO_ACCEPTANCE_MAX_AMOUNT_MINOR="100000"
IYZICO_ACCEPTANCE_REQUEST_IP=""
IYZICO_ACCEPTANCE_GIVEN_NAME=""
IYZICO_ACCEPTANCE_FAMILY_NAME=""
IYZICO_ACCEPTANCE_IDENTITY_NUMBER=""
IYZICO_ACCEPTANCE_PHONE=""
IYZICO_ACCEPTANCE_ADDRESS=""
IYZICO_ACCEPTANCE_CITY=""
IYZICO_ACCEPTANCE_COUNTRY=""
IYZICO_ACCEPTANCE_ZIP_CODE=""
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
PAYMENT_RECONCILIATION_BATCH_SIZE="25"
PAYMENT_RECONCILIATION_MIN_AGE_MINUTES="30"
PAYMENT_RECONCILIATION_RETRY_DELAY_MINUTES="15"
PAYMENT_RECONCILIATION_MAX_ATTEMPTS="12"
PAYMENT_RECONCILIATION_JOB_LEASE_TTL_MS="300000"
PAYMENT_RECONCILIATION_SCHEDULE_CONFIGURED="false"
PAYMENT_RECONCILIATION_SCHEDULE_MAX_AGE_SECONDS="1800"
# Admin-only operasyon görünümünde uyarı üretir; otomatik ceza veya bakiye işlemi yapmaz.
PAYMENT_OPEN_CASE_ALERT_THRESHOLD="25"
PAYMENT_DEAD_LETTER_ALERT_THRESHOLD="10"
# Bu surum yalniz sandbox kabul eder. `live` fail-closed kalir.
PAYTR_CHECKOUT_MODE=disabled
# Durable orchestration hazırdır; resmi sandbox kabulü tamamlanana kadar production'da disabled kalır.
PAYTR_REFUND_MODE=disabled
# Yalnız manuel sandbox kabul komutunda kullanılır; kalıcı env dosyasına yazmayın.
PAYTR_REFUND_SANDBOX_ACCEPTANCE_CONFIRM=""
PAYTR_REFUND_ACCEPTANCE_ORDER_ID=""
PAYTR_REFUND_ACCEPTANCE_REQUESTER_USER_ID=""
PAYTR_REFUND_ACCEPTANCE_REVIEWER_USER_ID=""
# TRUST_PROXY=false olan local sandbox testlerinde server-owned test IP fallback'i.
PAYTR_SANDBOX_USER_IP=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Checkout adapter exists but remains disconnected and sandbox-only.
STRIPE_CHECKOUT_MODE=disabled
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
PAYMENT_WEBHOOK_MAX_BODY_BYTES=262144
PAYMENT_WEBHOOK_BATCH_SIZE=25
PAYMENT_WEBHOOK_MAX_ATTEMPTS=8
PAYMENT_WEBHOOK_CLAIM_TTL_MS=300000
PAYMENT_WEBHOOK_JOB_LEASE_TTL_MS=300000
PAYMENT_WEBHOOK_SCHEDULE_CONFIGURED=false
PAYMENT_WEBHOOK_SCHEDULE_MAX_AGE_SECONDS=180
PAYMENT_LEGAL_APPROVED=false
PAYMENT_LEGAL_APPROVAL_EVIDENCE_FILE=""
PAYMENT_LEGAL_APPROVAL_EVIDENCE_SHA256=""
PAYMENT_LEGAL_APPROVAL_CONFIRM=""
PAYMENT_LEGAL_APPROVAL_REFERENCE=""
# Keep stable during rollout; changing this value reshuffles registered-user cohorts.
PAYMENT_ROLLOUT_SEED=""
PAYMENT_LEGAL_BUSINESS_NAME=replace_with_legal_business_name
PAYMENT_LEGAL_BUSINESS_ADDRESS=replace_with_legal_business_address
PAYMENT_LEGAL_CONTACT_EMAIL=replace_with_payment_support_email
PAYMENT_CHECKOUT_TERMS_VERSION=checkout-terms-draft-v1
PAYMENT_PRIVACY_NOTICE_VERSION=payment-privacy-draft-v1
PAYMENT_DISTANCE_SALES_NOTICE_VERSION=distance-sales-draft-v1

# Admin Access Gateway Policy
# ADMIN_ACCESS_MODE:
# - public_login: mevcut uygulama ici admin login davranisi
# - restricted_login: admin login / admin API sadece ek policy saglanirsa acik
# - external_gateway: admin yuzeyi harici gateway/Zero Trust arkasi icin optimize mod
ADMIN_ACCESS_MODE="public_login"

# Production'da policy eksikse admin yuzeyini kapatmak icin "true" kullan.
# Local gelistirmede genelde "false" gerekmez; varsayilan local bypass ile rahat calisir.
ADMIN_ACCESS_FAIL_CLOSED="true"

# Localhost / 127.0.0.1 isteklerini development ortaminda policy disi birak.
# Production'da etkisi yoktur.
ADMIN_ACCESS_ALLOW_LOCAL_DEV_BYPASS="true"

# Harici gateway bir sabit header birakiyorsa kullan.
# Ornek:
# ADMIN_ACCESS_HEADER_NAME="x-admin-access"
# ADMIN_ACCESS_HEADER_VALUE="approved"
ADMIN_ACCESS_HEADER_NAME=""
ADMIN_ACCESS_HEADER_VALUE=""

# Cloudflare Zero Trust gibi sistemler kullanici email'ini header ile gecirebilir.
# Header adini burada belirt, izinli email veya domainleri asagida tanimla.
# Ornek:
# ADMIN_ACCESS_EMAIL_HEADER_NAME="cf-access-authenticated-user-email"
ADMIN_ACCESS_EMAIL_HEADER_NAME=""

# Virgulle ayrilmis tam email allowlist.
# Ornek: "admin@firma.com,ops@firma.com"
ADMIN_ACCESS_ALLOWED_EMAILS=""

# Virgulle ayrilmis domain allowlist.
# Ornek: "firma.com,internal.firma.com"
ADMIN_ACCESS_ALLOWED_EMAIL_DOMAINS=""

# Transactional email. Keep EMAIL_PROVIDER=disabled until SMTP and the worker
# schedule are ready. Generate EMAIL_TOKEN_SECRET independently from AUTH_SECRET.
# Production deploy preflight requires: smtp | disabled_risk_accepted
PRODUCTION_EMAIL_POLICY=disabled_risk_accepted
EMAIL_PROVIDER=disabled
EMAIL_FROM="Hushle <no-reply@example.com>"
EMAIL_TOKEN_SECRET=replace_with_at_least_32_random_characters
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SES/SNS feedback is disabled locally. In production choose ses_sns or an
# explicit provider_managed_risk_accepted policy.
PRODUCTION_EMAIL_FEEDBACK_POLICY=disabled
SES_FEEDBACK_WEBHOOK_ENABLED=false
SES_SNS_TOPIC_ARNS=
SES_ALLOWED_SOURCE_ARNS=
SES_SNS_AUTO_CONFIRM=false
SES_FEEDBACK_WEBHOOK_RATE_LIMIT_PER_MINUTE=600
EMAIL_DELIVERY_BATCH_SIZE=25
EMAIL_DELIVERY_LEASE_TTL_MS=900000
EMAIL_SENT_RETENTION_DAYS=30
EMAIL_DEAD_LETTER_RETENTION_DAYS=90
EMAIL_TOKEN_RETENTION_DAYS=7
EMAIL_PENDING_ACCOUNT_RETENTION_DAYS=7
EMAIL_RETENTION_BATCH_SIZE=500
EMAIL_RETENTION_LEASE_TTL_MS=300000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
