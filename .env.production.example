NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3001
# Ornek: https://app.example.com,https://admin.example.com
API_ALLOWED_ORIGINS=
HOST=0.0.0.0
PORT=3000

NEXTAUTH_URL=https://hushle.com
NEXT_PUBLIC_SITE_URL=https://hushle.com
TRUSTED_WEB_ORIGINS=https://hushle.com
AUTH_SECRET=replace_with_long_random_secret
AUTH_TRUST_HOST=true
TRUST_PROXY=true

# Public launch decision: google | disabled_risk_accepted
PRODUCTION_OAUTH_POLICY=google
GOOGLE_OAUTH_ENABLED=true
AUTH_GOOGLE_ID=replace_with_google_oauth_client_id
AUTH_GOOGLE_SECRET=replace_with_google_oauth_client_secret
HEALTHCHECK_TOKEN=replace_with_long_random_health_token

PRODUCTION_OBSERVABILITY_POLICY=http
OBSERVABILITY_EXPORT_MODE=http
OBSERVABILITY_EXPORT_URL=https://collector.example.com/v1/events
OBSERVABILITY_EXPORT_TOKEN=replace_with_independent_observability_token
OBSERVABILITY_EXPORT_BATCH_SIZE=20
OBSERVABILITY_EXPORT_QUEUE_LIMIT=500
OBSERVABILITY_EXPORT_FLUSH_INTERVAL_MS=5000
OBSERVABILITY_EXPORT_TIMEOUT_MS=3000

MYSQL_DATABASE=hushle
MYSQL_USER=hushle
MYSQL_PASSWORD=replace_with_mysql_app_password
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password
DATABASE_URL=mysql://hushle:replace_with_mysql_app_password@mysql:3306/hushle
DATABASE_CONNECTION_LIMIT=20

RATE_LIMIT_ENABLED=true
PASSWORD_BREACH_CHECK_ENABLED=true
ALLOW_ORIGINLESS_SOCKET_CLIENTS=false
STATE_CHANGE_ORIGIN_POLICY=strict

REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=hushle:production
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_RETRY_COOLDOWN_MS=30000

# Room state process-local kaldigi icin production tek app replica kullanir.
INSTANCE_ID=hushle-app-1
REALTIME_TOPOLOGY=single-writer
REALTIME_REPLICA_COUNT=1
SOCKET_IO_POLLING_ENABLED=true
SOCKET_IO_REDIS_ADAPTER_ENABLED=false
SOCKET_IO_STICKY_SESSIONS_CONFIGURED=false
ROOM_OWNERSHIP_LEASE_ENABLED=false
ROOM_OWNERSHIP_LEASE_TTL_MS=30000
ROOM_OWNERSHIP_RENEW_INTERVAL_MS=10000

# Non-triggered match finalize events use PII-free daily Redis rollups.
MATCH_FINALIZE_TELEMETRY_ROLLUP_ENABLED=true
TELEMETRY_ROLLUP_RETENTION_DAYS=45

# Mutating jobs still require explicit execute mode; this gate allows the scheduler.
JOBS_ENABLED=true
JOBS_DATABASE_CONNECTION_LIMIT=3
AUDIT_HOT_RETENTION_DAYS=90
AUDIT_ARCHIVE_BATCH_SIZE=500
AUDIT_ARCHIVE_MAX_BATCHES=10
AUDIT_ARCHIVE_LEASE_TTL_MS=900000

# Public launch decisions. Use disabled_risk_accepted only with a written risk record.
PRODUCTION_CAPTCHA_POLICY=turnstile
TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
TURNSTILE_ALLOWED_HOSTNAMES=hushle.com

PRODUCTION_EDGE_SECURITY_POLICY=cloudflare_free_safe_launch
CLOUDFLARE_PROXY_ENABLED=true
CLOUDFLARE_ORIGIN_LOCK_MODE=firewall
CLOUDFLARE_BOT_FIGHT_MODE=disabled_until_webhook_smoke
PAYMENT_WEBHOOK_EDGE_POLICY=signature_first_no_challenge

# Payment provider secrets belong in the deployment secret manager. Checkout is
# fail-closed until a reviewed adapter explicitly reports ready.
PAYMENTS_ENABLED=false
PAYMENT_ACTIVE_PROVIDER=""
SHOPIER_PERSONAL_ACCESS_TOKEN=""
SHOPIER_PRODUCT_MEDIA_URL=""
SHOPIER_CHECKOUT_MODE=disabled
SHOPIER_WEBHOOK_MODE=disabled
SHOPIER_RECONCILIATION_MODE=disabled
SHOPIER_REFUND_MODE=disabled
SHOPIER_WEBHOOK_TOKEN=""
SHOPIER_ACCOUNT_ID=""
SHOPIER_LIVE_ACCEPTANCE_RECORDED=false
SHOPIER_LIVE_ACCEPTANCE_EVIDENCE_FILE=""
SHOPIER_LIVE_ACCEPTANCE_EVIDENCE_SHA256=""
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_MERCHANT_ID=""
# UI and orchestration are sandbox-only and require explicit acceptance evidence.
IYZICO_CHECKOUT_MODE=disabled
IYZICO_WEBHOOK_MODE=disabled
IYZICO_RECONCILIATION_MODE=disabled
IYZICO_OWNER_CHECKOUT_MODE=disabled
IYZICO_CALLBACK_MODE=disabled
IYZICO_SANDBOX_ACCEPTANCE_RECORDED=false
IYZICO_SANDBOX_ACCEPTANCE_EVIDENCE_FILE=/srv/hushle/payment-evidence/iyzico-sandbox-acceptance.json
IYZICO_SANDBOX_ACCEPTANCE_EVIDENCE_SHA256=""
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# Current checkout orchestration is sandbox-only; live remains fail-closed.
PAYTR_CHECKOUT_MODE=disabled
# Production refund execution is not wired; keep fail-closed.
PAYTR_REFUND_MODE=disabled
PAYTR_SANDBOX_USER_IP=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Turkey merchant eligibility and webhook orchestration remain blockers.
STRIPE_CHECKOUT_MODE=disabled
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
PAYMENT_WEBHOOK_MAX_BODY_BYTES=262144
PAYMENT_WEBHOOK_BATCH_SIZE=25
PAYMENT_WEBHOOK_MAX_ATTEMPTS=8
PAYMENT_WEBHOOK_CLAIM_TTL_MS=300000
PAYMENT_WEBHOOK_JOB_LEASE_TTL_MS=300000
PAYMENT_WEBHOOK_SCHEDULE_CONFIGURED=false
PAYMENT_WEBHOOK_SCHEDULE_MAX_AGE_SECONDS=180
PAYMENT_RECONCILIATION_SCHEDULE_CONFIGURED=false
PAYMENT_RECONCILIATION_SCHEDULE_MAX_AGE_SECONDS=1800
PAYMENT_LEGAL_APPROVED=false
PAYMENT_EVIDENCE_DIR=/srv/hushle/payment-evidence
PAYMENT_LEGAL_APPROVAL_EVIDENCE_FILE=/srv/hushle/payment-evidence/payment-legal-approval.json
PAYMENT_LEGAL_APPROVAL_EVIDENCE_SHA256=""
# Secret-manager value; keep stable during a normal rollout.
PAYMENT_ROLLOUT_SEED=""
PAYMENT_LEGAL_BUSINESS_NAME=replace_with_legal_business_name
PAYMENT_LEGAL_BUSINESS_ADDRESS=replace_with_legal_business_address
PAYMENT_LEGAL_CONTACT_EMAIL=replace_with_payment_support_email
PAYMENT_CHECKOUT_TERMS_VERSION=checkout-terms-draft-v1
PAYMENT_PRIVACY_NOTICE_VERSION=payment-privacy-draft-v1
PAYMENT_DISTANCE_SALES_NOTICE_VERSION=distance-sales-draft-v1

ADMIN_ACCESS_MODE=external_gateway
ADMIN_ACCESS_FAIL_CLOSED=true
ADMIN_ACCESS_ALLOW_LOCAL_DEV_BYPASS=false
ADMIN_ACCESS_EMAIL_HEADER_NAME=cf-access-authenticated-user-email
ADMIN_ACCESS_ALLOWED_EMAILS=admin@hushle.com
ADMIN_ACCESS_ALLOWED_EMAIL_DOMAINS=
ADMIN_ACCESS_HEADER_NAME=
ADMIN_ACCESS_HEADER_VALUE=

PRODUCTION_EMAIL_POLICY=smtp
EMAIL_PROVIDER=smtp
EMAIL_FROM="Hushle <no-reply@hushle.com>"
EMAIL_TOKEN_SECRET=replace_with_independent_email_token_secret
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
PRODUCTION_EMAIL_FEEDBACK_POLICY=ses_sns
SES_FEEDBACK_WEBHOOK_ENABLED=true
SES_SNS_TOPIC_ARNS=arn:aws:sns:replace_with_region:000000000000:replace_with_topic
SES_ALLOWED_SOURCE_ARNS=arn:aws:ses:replace_with_region:000000000000:identity/replace_with_verified_identity
SES_SNS_AUTO_CONFIRM=false
SES_FEEDBACK_WEBHOOK_RATE_LIMIT_PER_MINUTE=600
EMAIL_DELIVERY_BATCH_SIZE=25
EMAIL_DELIVERY_LEASE_TTL_MS=900000
EMAIL_SENT_RETENTION_DAYS=30
EMAIL_DEAD_LETTER_RETENTION_DAYS=90
EMAIL_TOKEN_RETENTION_DAYS=7
EMAIL_PENDING_ACCOUNT_RETENTION_DAYS=7
EMAIL_RETENTION_BATCH_SIZE=500
EMAIL_RETENTION_LEASE_TTL_MS=300000

BACKUP_REMOTE_ENABLED=true
BACKUP_S3_ENDPOINT=replace_with_s3_compatible_endpoint
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=replace_with_backup_bucket
BACKUP_S3_PREFIX=hushle-production
BACKUP_S3_ACCESS_KEY_ID=replace_with_backup_access_key
BACKUP_S3_SECRET_ACCESS_KEY=replace_with_backup_secret_key
BACKUP_S3_CLI_MODE=docker
BACKUP_REMOTE_RETENTION_DAYS=30
