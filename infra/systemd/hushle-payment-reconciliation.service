[Unit]
Description=Hushle payment reconciliation worker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hushle
Group=hushle
WorkingDirectory=/srv/hushle/app
Environment=APP_DIR=/srv/hushle/app
Environment=ENV_FILE=/srv/hushle/app/.env.production
Environment=PAYMENT_JOB_TIMEOUT_SECONDS=900
ExecStart=/srv/hushle/app/scripts/ops/run-payment-job.sh payment-reconciliation
TimeoutStartSec=16min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
